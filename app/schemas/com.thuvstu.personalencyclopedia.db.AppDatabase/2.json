    "views": [
      {
        "viewName": "SrsCurrentView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT sr.entryId, sr.grade, sr.intervalDays, sr.easeFactor, sr.nextReviewAt,\n           sr.reviewedAt AS lastReviewedAt\n    FROM srs_review sr\n    INNER JOIN (\n        SELECT entryId, MAX(reviewedAt) AS maxReviewedAt\n        FROM srs_review\n        GROUP BY entryId\n    ) latest ON sr.entryId = latest.entryId AND sr.reviewedAt = latest.maxReviewedAt"
      },
      {
        "viewName": "QuizMasteryView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT quizId, MAX(score) AS masteryScore FROM quiz_attempts GROUP BY quizId"
      }
    ],
